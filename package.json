{
  "name": "privatedelights-backend",
  "version": "1.0.0",
  "description": "Production-grade modular backend for PrivateDelights platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/seed/seedSuperAdmin.js",
    "seed:data": "node src/seed/seedSampleData.js",
    "seed": "node src/seed/seedSuperAdmin.js && node src/seed/seedSampleData.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "modular",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
